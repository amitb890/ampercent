<?xml version="1.0" encoding="UTF-8"?>
 <OpenSearchDescription xmlns="http://a9.com/-/spec/opensearch/1.1/" xmlns:ms-ose="http://schemas.microsoft.com/opensearchext/2009/">
   <ShortName>DeviantArt</ShortName>
   <Description>Search deviations on DeviantArt.com</Description>
   <Url type="application/rss+xml" 
        template="http://backend.deviantart.com/rss.xml?q=boost%3Apopular+{searchTerms}&amp;offset={startIndex}"/>
   <!-- The tags below should not be necessary, but they work around a bug in DeviantArt's MediaRSS implementation. -->
   <!-- DeviantArt should be supplying a "type" attribute on their <media:content> elements, but are not. -->
   <!-- This special flag tells Windows it can use the file extension from the URL to determine the item type.  -->
   <!-- This should NOT be used with most (properly implemented) sources.  -->
   <!-- Win7 M3 syntax -->
   <ms-ose:locationProperties>
     <ms-ose:property name="TreatLinkAsEnclosure">-1</ms-ose:property>
   </ms-ose:locationProperties>
   <!-- Win7 Beta syntax -->
   <ms-ose:ResultsProcessing format="application/rss+xml">
     <ms-ose:LinkIsFilePath>-1</ms-ose:LinkIsFilePath>
   </ms-ose:ResultsProcessing>
 </OpenSearchDescription>
        